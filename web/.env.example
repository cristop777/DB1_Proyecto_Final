# Copia este archivo como .env y ajusta las credenciales de PostgreSQL.
AUTOAUDIT_DB_HOST=127.0.0.1
AUTOAUDIT_DB_PORT=5432
AUTOAUDIT_DB_NAME=autoaudit_db
AUTOAUDIT_DB_USER=autoaudit_app
AUTOAUDIT_DB_PASSWORD=cambia_esta_clave

# Cuenta única que puede usar la interfaz web.
AUTOAUDIT_WEB_USER=admin
AUTOAUDIT_WEB_PASSWORD_HASH=pega_aqui_el_hash_de_la_contrasena

# Clave aleatoria para proteger la sesión local de Flask.
FLASK_SECRET_KEY=cambia_por_una_clave_larga_y_aleatoria

# Intenta abrir un navegador al iniciar si Ubuntu tiene entorno gráfico.
AUTOAUDIT_OPEN_BROWSER=true
